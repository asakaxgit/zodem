{
  "name": "zodem-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "example:generate": "pnpm --filter @example/shared run generate",
    "example:generate:check": "pnpm --filter @example/shared run generate:check",
    "example:buf:lint": "pnpm --filter @example/shared run buf:lint",
    "example:buf:breaking": "pnpm --filter @example/shared run buf:breaking",
    "example:dev": "concurrently -n server,web -c blue,green \"pnpm --filter @example/server run dev\" \"pnpm --filter @example/web run dev\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.10.5",
    "concurrently": "10.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "esbuild"
    ]
  }
}
