{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/src/gen",
      "!**/.tmp-*",
      "!examples/fullstack/shared/proto"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      },
      "nursery": {
        "noUnsafeTypeAssertion": "error",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "expression"
          }
        },
        "useExhaustiveSwitchCases": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noMisleadingReturnType": "error",
        "useNullishCoalescing": "error",
        "noUselessTypeConversion": "error",
        "useRegexpTest": "error",
        "useStringStartsEndsWith": "error",
        "useIncludes": "error",
        "noNegationInEqualityCheck": "error",
        "useUnicodeRegex": "error"
      }
    },
    "domains": {
      "types": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}