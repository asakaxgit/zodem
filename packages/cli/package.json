{
  "name": "@zodem/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zodem": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zodem/core": "workspace:*",
    "@zodem/proto": "workspace:*",
    "jiti": "2.7.0",
    "tinyglobby": "0.2.17"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
